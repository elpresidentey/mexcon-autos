# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Direct DB access (used by scripts/ only; never exposed to the browser)
DATABASE_URL=postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxx

# App Configuration
VITE_APP_NAME=Mexcon Autos
VITE_WHATSAPP_NUMBER=+234XXXXXXXXXX
VITE_CONTACT_EMAIL=info@mexconautos.com
VITE_CONTACT_PHONE=+234XXXXXXXXXX

# Payment Gateways (optional; leave blank to hide card options at checkout)
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
VITE_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
